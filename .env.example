APP_NAME=Ticketing System
APP_DEBUG=true
APP_DATABASE_URL=postgresql://user:password@localhost:5432/ticketing
# Debe apuntar a otra base. Los tests rechazan cualquier URL que coincida con desarrollo.
APP_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/ticketing_test
APP_SECRET_KEY=change-this-secret-key
APP_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_ARCHIVE_CLOSED_TICKETS_AFTER_DAYS=30

# Celery consulta tickets vencidos cada minuto. Cada fase procesa como máximo
# 100 tickets y el lock Redis dura más que el límite total de la tarea.
APP_CELERY_BROKER_URL=redis://localhost:6379/0
APP_REDIS_URL=redis://localhost:6379/0
APP_AUTO_ASSIGNMENT_POLL_SECONDS=60
APP_AUTO_ASSIGNMENT_BATCH_SIZE_PER_PHASE=100
APP_AUTO_ASSIGNMENT_TASK_TIME_LIMIT_SECONDS=240
APP_AUTO_ASSIGNMENT_LOCK_TIMEOUT_SECONDS=300
